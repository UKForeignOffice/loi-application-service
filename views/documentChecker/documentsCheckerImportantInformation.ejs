<%
    var backLink = '/choose-documents-or-skip';

    if(typeof doc_checker_page_before_important_information !== 'undefined') {
        backLink = doc_checker_page_before_important_information;
    }
    else if(typeof last_business_application_page !== 'undefined') {
        backLink = '/business-document-quantity';
        continueLink = '/business-additional-information';
    }
%>

<div class="inner_header <%if (!user_data.loggedIn){%>no-user-signed-in<%}%>" >
    <a href="<%= backLink %>" class="govuk-back-link">Back</a>
    <% //User email and logout link
    if (user_data.loggedIn) { %>
    <%- partial ('../partials/inner-header.ejs')%>
    <% } %>
</div>

<div class="govuk-error-summary <% if (error_report) { %>show<% } else { %>hide<% } %>" role="alert" tabindex="-1" autofocus>
    <h2 class="govuk-error-summary__title" id="error-summary-heading">
        There is a problem
    </h2>
    <ul class="govuk-list govuk-error-summary__list">
        <% if (error_report) { %>
            <% error_report[0][0].errMsgs.forEach(function(errorMsgs) { %>
                <li><a href="#<%= errorMsgs.questionId %>"><%= errorMsgs.fieldSolution %></a></li>
            <% }) %>
        <% } %>
    </ul>
</div>

<h1 class="govuk-heading-xl" xmlns="http://www.w3.org/1999/xhtml">Important Information</h1>

<div class="govuk-grid-row">
<div class="govuk-grid-column-two-thirds">
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Please read the following information to prevent potential delays to your application.
        </strong>
    </div>

    <ul class="govuk-list govuk-list--bullet">
        <li>Only send in the documents you require to be legalised.</li>
        <li>Signatures signed “per pro” (p.p.) are not accepted.</li>
    </ul>

    <p class="govuk-body">
        If there is more than one signature on the document which meets our requirements, you must confirm which signature you require to be legalised. If this is not stated, we will legalise the most recent signature.
    </p>
    <p class="govuk-body govuk-!-font-weight-bold">
        If your document is one of the following:
    </p>
    <ul class="govuk-list govuk-list--bullet">
        <li>Certified document (e.g. by a solicitor or notary public)</li>
        <li>Medical document</li>
        <li>Marriage certificate (signed by a minister of religion or authorised person)</li>
    </ul>
    <p class="govuk-body">
        Please include contact details for the signatory, including their email address and place of practice. This is essential should we need to contact them to verify their signature.
    </p>
    <p class="govuk-body govuk-!-font-weight-bold">
        If you do not provide these details your application may be delayed.
    </p>

    <form action="/check-documents-important-information" method="post">
    <div class="govuk-form-group">
            <h2 class="govuk-heading-m nomargintop">Signature Date Requirements</h2>
            <p class="govuk-body">If a document is signed by one of the following types of public officials, and the signature is older than the timeframes listed below and we do not already hold a matching entry in our system, we will reject the document and issue a refund:</p>
            <ul class="govuk-list govuk-list--bullet">
                  <li>Legal capacity (e.g. notary public or solicitor): 15 years ago</li>
                  <li>Minister of Religion, Authorised Person, Secretary for Marriages: 50 years ago</li>
                  <li>Registrar (General Register Office): 70 years ago</li>
            </ul>
        </div>

        <div class="govuk-form-group">
            <h2 class="govuk-heading-m nomargintop">Laminated and Hard-backed Documents</h2>
            <p class="govuk-body">We are unable to legalise laminated or hard-backed documents as it is not possible to securely attach the apostille certificate. In order to legalise the document, the laminate or hard backing will need to be removed, or a replacement document will need to be obtained without these features.</p>
        </div>

        <div class="govuk-form-group">
            <h2 class="govuk-heading-m nomargintop">Incomplete Documents</h2>
            <p class="govuk-body">Where documents contain multiple pages, all the pages must be included when submitting the document for legalisation. All pages referenced by a certification must be submitted. Incomplete documents will not be accepted.</p>
        </div>

        <div class="govuk-form-group">
            <h2 class="govuk-heading-m nomargintop">Reproduction of UK Apostilles</h2>
            <p class="govuk-body">If you are submitting a document containing a reproduction of a UK apostille, please note that it must not contain the FCDO Seal or the signature of the FCDO official.</p>
        </div>

        <div class="govuk-form-group">
            <h2 class="govuk-heading-m nomargintop">Attached Documents</h2>
            <p class="govuk-body">All documents which are attached should be referenced in the certification. Photocopies of General Register Office documents, ACRO/DBS/Disclosure certificates and fingerprint documents cannot be submitted as attached documents.</p>
        </div>

        <div class="govuk-form-group<% if (error_report) { %> error<% } %>">
            <label class="govuk-visually-hidden" for="user_accepts">You agree to the terms and conditions when you select this checkbox</label>
            <span class="govuk-error-message">
                <% if (error_report && error_report[0][0].errMsgs.length) { %>
                    <% error_report[0][0].errMsgs.forEach(function(errorMsgs) { %>
                        <span class="govuk-visually-hidden">Error:</span>
                        <%= errorMsgs.fieldSolution %>
                    <% }) %>
                <% } else if (typeof show_accept_error !== 'undefined' && show_accept_error) { %>
                    <span class="govuk-visually-hidden">Error:</span>
                        Confirm that your documents meet the requirements for legalisation and that you understand that you will not receive a refund if they are rejected
                <% } %>
            </span>
            <div class="govuk-checkboxes__item documents-checker-important-information__checkbox-item">
                <input
                        class="govuk-checkboxes__input"
                        type="checkbox"
                        name="user_accepts"
                        id="user_accepts"
                        value="yes"
                        <%= user_accepts ? 'checked' : '' %>
                >
                <label class="govuk-checkboxes__label" for="user_accepts">
                    I confirm that my documents meet the requirements for legalisation and understand that I will not be refunded if they are rejected.
                </label>
            </div>
        </div>

        <div class="govuk-form-group">
            <input type="submit"  id='NextBtn' class="govuk-button" data-module="govuk-button" value="Continue" />
        </div>
    </form>
</div>
</div>
