<% pageTitle ="Confirm your document is certified" %>
<% var hasErrors = Array.isArray(error_report) && error_report.length > 0; %>
<%if(hasErrors){
    pageTitle ="Error: Confirm your document is certified"
} %>
<div class="inner_header <%if (!user_data.loggedIn){%>no-user-signed-in<%}%>" >
    <a href="<%= last_doc_checker_page%>" class="govuk-back-link">Back</a>

    <%
    //User email and logout link
    if (user_data.loggedIn) { %>
    <%- partial ('../partials/inner-header.ejs')%>
    <% } %>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <% if (hasErrors) { %>
            <div
                class="govuk-error-summary"
                aria-labelledby="error-summary-title"
                role="alert"
                tabindex="-1"
                data-module="govuk-error-summary">
                <h2 class="govuk-error-summary__title" id="error-summary-title">
                    There is a problem
                </h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <% error_report.forEach(function(errorMsgs) { %>
                            <li><a href="#<%= errorMsgs[0].questionId %>"><%= errorMsgs[0].fieldSolution %></a></li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        <% } %>

        <h1 class="govuk-heading-xl govuk-!-margin-bottom-3">Confirm your document<% if (docs_to_cert.length>1) { %>s are <% } else { %> is <% } %>certified</h1>

<form action="/check-documents-certified/confirm" id="documentsCertifiedConf" method="post">
    <%
    if (docs_to_cert.length > 0 ){%>
    <% for(let i=0; i<users_docs.length; i++) { %>
    <% if (docs_to_cert.toString().indexOf(users_docs[i].doc_id) > -1) { %>
    <div class="govuk-form-group govuk-!-margin-bottom-9 <% if (hasErrors && JSON.stringify(error_report).indexOf(users_docs[i].doc_id)>-1) { %>govuk-form-group--error<% } %>" id="docid_<%= users_docs[i].doc_id %>">
        <h3 class="govuk-heading-m">
            <%= users_docs[i].doc_title_start.trim() %> <% if (users_docs[i].doc_title_start.trim()==='Professional' || users_docs[i].doc_title.trim()=='Diploma' || users_docs[i].doc_title.trim()=='Degree Certificate or Transcript' || users_docs[i].doc_title.trim()=='Educational') { %>(UK)<% } %>
        </h3>
        <fieldset class="govuk-fieldset">
            <legend id="legend_docid_<%= users_docs[i].doc_id %>" class="govuk-visually-hidden">
            <span class="govuk-fieldset__heading">
                <%= users_docs[i].doc_title_start.trim() %>
            </span>
            </legend>
            <% if (error_report) { %>
                <% error_report.forEach(function(errorMsgs) { %>
                    <% if (errorMsgs[0].questionId.indexOf(users_docs[i].doc_id) > -1) { %>
                        <p class="govuk-error-message"><span class="govuk-visually-hidden">Error: </span><%= errorMsgs[0].fieldSolution %></p>
                    <% } %>
                <% }) %>
            <% } %>

          <%
            let degreeCertCustomText = '';
            let diplomaCustomText = '';
            let drivingLicenceCustomText = '';
            let educationCertCustomText = '';
            let lastingPowerOfAttorneyOriginalCustomText = '';
            let lastingPowerOfAttorneyCopyCustomText = '';
            let passportCustomText = '';
            let professionalQualificationCertCustomText = '';
            let translationCustomText = '';
            let ukCrownDependencyCustomText = '';
            let ukOverseasTerritoryCustomText = '';
          %>

        <% if (session.docs_to_cert.includes("221") && session.eligible_input["docid_221"].includes("_customText")) { %>
          <% degreeCertCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("224") && session.eligible_input["docid_224"].includes("_customText")){ %>
          <% diplomaCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("227") && session.eligible_input["docid_227"].includes("_customText")){ %>
          <% drivingLicenceCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("228") && session.eligible_input["docid_228"].includes("_customText")){ %>
          <% educationCertCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("274") && session.eligible_input["docid_274"].includes("_customText") && session.eligible_input["docid_274"].includes("_lpaOriginal")){ %>
          <% lastingPowerOfAttorneyOriginalCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("274") && session.eligible_input["docid_274"].includes("_customText") && session.eligible_input["docid_274"].includes("_lpaCopy")){ %>
          <% lastingPowerOfAttorneyCopyCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("247") && session.eligible_input["docid_247"].includes("_customText")){ %>
          <% passportCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("251") && session.eligible_input["docid_251"].includes("_customText")){ %>
          <% professionalQualificationCertCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("258") && session.eligible_input["docid_258"].includes("_customText")){ %>
          <% translationCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("272") && session.eligible_input["docid_272"].includes("_customText")){ %>
          <% ukCrownDependencyCustomText = true; %>
        <% } %>

        <% if (session.docs_to_cert.includes("273") && session.eligible_input["docid_273"].includes("_customText")){ %>
          <% ukOverseasTerritoryCustomText = true; %>
        <% } %>


                <% if (
                    (users_docs[i].doc_title_start.trim()=='Degree certificate or transcript (UK)' && degreeCertCustomText) ||
                    (users_docs[i].doc_title_start.trim()=='Professional qualification certificate' && professionalQualificationCertCustomText) ||
                    (users_docs[i].doc_title_start.trim()=='Diploma' && diplomaCustomText) ||
                    (users_docs[i].doc_title_start.trim()=='Educational certificate (UK)' && educationCertCustomText)
                    )
                 { %>
                <p class="govuk-body">Your <%= users_docs[i].doc_title_mid.trim() %> must be certified by either:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>a solicitor or notary public in the UK</li>
                    <li>an official of the British Council (only original certificates; please check with your local British Council first as this service is not available at all locations). The official must sign, certify, and date the document.</li>
                </ul>
                <% } %>


            <% if(users_docs[i].doc_title.trim()=='Disclosure and Barring Service (DBS) document' || users_docs[i].doc_title.trim()=='ACCA Certificate' ||
                  users_docs[i].doc_title.trim()=='Access NI Document' || users_docs[i].doc_title.trim()=='Criminal Records Check' ||
                  users_docs[i].doc_title.trim()=='Disclosure Scotland Document' || users_docs[i].doc_title.trim()=='Fingerprints Document' ||
                  users_docs[i].doc_title.trim()=='Gender Recognition Certificate') { %>

                <p class="govuk-body">Your original <%= users_docs[i].doc_title_mid.trim() %> must be certified by a solicitor or notary public in the UK.</p>
            <% } else if (
                    (users_docs[i].doc_title_start.trim()=='Degree certificate or transcript (UK)' && !degreeCertCustomText) ||
                    (users_docs[i].doc_title_start.trim()=='Professional qualification certificate' && !professionalQualificationCertCustomText) ||
                    (users_docs[i].doc_title_start.trim()=='Diploma' && !diplomaCustomText) ||
                    (users_docs[i].doc_title_start.trim()=='Educational certificate (UK)' && !educationCertCustomText)
            ) { %>
                <p class="govuk-body">Your <%= users_docs[i].doc_title_mid.trim() %> must be certified by a solicitor or notary public in the UK.</p>
            <% } else if (
                    users_docs[i].doc_title.trim()=='Certificate of Naturalisation' ||
                    users_docs[i].doc_title.trim()=='UK Marriage Certificate Issued By A Place Of Worship'
            ) { %>
                <p class="govuk-body">Your <%= users_docs[i].doc_title_mid.trim() %> needs to be signed, certified and dated in the UK by either a UK practising solicitor or notary public.</p>
            <% }  else if (
                   users_docs[i].doc_title.trim()=='Passport'
           ) { %>
               <p class="govuk-body">Your photocopy passport must be certified by a solicitor or notary public in the UK.<br><strong>Please do not send any original passports</strong>.</p>
            <% }  else if (
                   users_docs[i].doc_title.trim()=='Driving Licence'
           ) { %>
               <p class="govuk-body">Your photocopy driving licence must be certified by a solicitor or notary public in the UK.<br><strong>Please do not send in your original driving licence</strong>.</p>
           <% } %>

           <% if (!(users_docs[i].doc_title.trim()=='Lasting Power of Attorney' || users_docs[i].doc_title.trim()=='UK Crown Dependency document' || users_docs[i].doc_title.trim()=='UK Overseas Territory document' )) { %>
            <% if (!(users_docs[i].doc_title.trim()=='Driving Licence' || users_docs[i].doc_title.trim()=='Degree Certificate or Transcript (UK)' || users_docs[i].doc_title.trim()=='Diploma' || users_docs[i].doc_title.trim()=='Educational Certificate (UK)' || users_docs[i].doc_title.trim()=='Passport'
                    || users_docs[i].doc_title.trim()=='Professional Qualification Certificate' || users_docs[i].doc_title.trim()=='Disclosure and Barring Service (DBS) document'
                    || users_docs[i].doc_title.trim()=='ACCA Certificate' || users_docs[i].doc_title.trim()=='Access NI Document' || users_docs[i].doc_title.trim()=='Criminal Records Check'
                    || users_docs[i].doc_title.trim()=='Disclosure Scotland Document' || users_docs[i].doc_title.trim()=='Fingerprints Document'
                    || users_docs[i].doc_title.trim()=='Gender Recognition Certificate')) { %>

              <p class="govuk-body">Your <%= users_docs[i].doc_title_mid.trim() %> must be certified by a solicitor or notary public in the UK.</p>
            <% } %>
            <p class="govuk-body">When the solicitor or notary public signs the document, they must:</p>
                        <ul class="govuk-list govuk-list--bullet">
                            <li>have a valid practising certificate</li>
                            <li>sign the document in the UK</li>
                            <li>use their personal signature, not a company signature</li>
                            <li>print their name and company address</li>
                            <li>include their seal (if applicable) on the same page as their signature – if an embossed seal is used, the embossment must go through the document and be present on both sides of the page.</li>
                            <li>include the date of certification</li>
                            <li>state the action they have taken eg witnessed, certified a copy, confirmed as original</li>
                        </ul>

                      <div class="govuk-inset-text panel-border-wide">
                        <p class="govuk-body">The solicitor or notary public’s signature must be an
                          original, hand-written signature. We can't accept a photocopy
                          or scan of a signature.</p>
                      </div>
            <% } %>

          <% if ( users_docs[i].doc_title.trim()=='Translation' ) { %>
            <ul class="govuk-list govuk-list--bullet">
                <li>The translation must be carried out in the UK.</li>
                <li>Translated documents cannot contain a reproduction of the official crest/emblem/signature of the official from the issuing authority, contained in the original document. This includes translations of previously issued apostilles.</li>
                <li>If the document is in a foreign text, the certification from the solicitor or notary public must confirm the type of document it is.</li>
                <li>If the document is an educational document issued outside of the UK, the solicitor or notary public must also confirm that they have checked the accreditation of the issuer and verified the authenticity of the educational certificate.</li>
                <li>If the document is a Lasting Power of Attorney, the original document must be included when submitting the document.</li>
            </ul>
          <% } %>


          <% if (users_docs[i].doc_title.trim()=='Passport') { %>
            <div class="govuk-warning-text">
              <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
              <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Your UK passport must be signed by the holder before being copied unless it states the holder is not required to sign.
              </strong>
            </div>


         <% } %>

          <% if (!(users_docs[i].doc_title.trim()=='Lasting Power of Attorney' || users_docs[i].doc_title.trim()=='UK Crown Dependency document' || users_docs[i].doc_title.trim()=='UK Overseas Territory document' )) { %>
            <p class="govuk-body">We do not accept certifications carried out by the following:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>accountant;</li>
                <li>bank official;</li>
                <li>legal assistant/secretary/receptionist;</li>
                <li>post office official;</li>
                <li>paralegal;</li>
                <li>trainee solicitor;</li>
                <li>teacher/lecturer/university administrator</li>
            </ul>
            <p class="govuk-body">If they add a cover sheet, it must be attached to the document. The cover sheet must also contain a specific reference to the document they have certified. If a notary public has certified the document in England and Wales, the cover sheet must be securely attached to the document e.g. book bound/metal rivet.</p>
            <p class="govuk-body">If a notary public from England, Wales or Northern Ireland signs a document for legalisation, they must also stamp or emboss the document with their notarial seal.</p>
            <p class="govuk-body">You can find:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li><a href="https://www.lawsociety.org.uk/" target="_blank" rel="noreferrer noopener">solicitors in England and Wales</a></li>
                <li><a href="https://www.facultyoffice.org.uk/notaries/find-a-notary/" target="_blank" rel="noreferrer noopener">notaries public in England and Wales</a></li>
                <li><a href="https://www.lawscot.org.uk/" target="_blank" rel="noreferrer noopener">solicitors and notaries public in Scotland</a></li>
                <li><a href="https://lawsoc-ni.org/" target="_blank" rel="noreferrer noopener">solicitors and notaries public in Northern Ireland</a></li>
            </ul>
            <% } %>

                 <% if (users_docs[i].doc_title.trim()=='Lasting Power of Attorney' && lastingPowerOfAttorneyOriginalCustomText) { %>
                  <p class="govuk-body">Your document must be registered with the Office of the Public Guardian. In England and Wales, it will bear the original embossed validation “VALIDATED-OPG” at the bottom of every page.</p>
                 <% } %>

                 <% if (users_docs[i].doc_title.trim()=='Lasting Power of Attorney' && lastingPowerOfAttorneyCopyCustomText) { %>
                  <p class="govuk-body">Your document must be registered with the Office of the Public Guardian. In England and Wales, it will bear the original embossed validation “VALIDATED-OPG” at the bottom of every page.
                  This will be visible on copies of Lasting Power of Attorney documents.</p>
                  <p class="govuk-body">Your <strong><%= users_docs[i].doc_title.trim() %></strong> must be certified by a solicitor or notary public in the UK.</p>
                  <p class="govuk-body">When the solicitor or notary public signs the document, they must:</p>
                  <ul class="govuk-list govuk-list--bullet">
                      <li>have a valid practising certificate</li>
                      <li>sign the document in the UK</li>
                      <li>use their personal signature, not a company signature</li>
                      <li>print their name and company address</li>
                      <li>include their seal (if applicable) on the same page as their signature – if an embossed seal is used, the embossment must go through the document and be present on both sides of the page.</li>
                      <li>include the date of certification</li>
                      <li>state the action they have taken eg witnessed, certified a copy, confirmed as original</li>
                  </ul>

                <div class="govuk-inset-text panel-border-wide">
                  <p class="govuk-body">The solicitor or notary public’s signature must be an
                    original, hand-written signature. We can't accept a photocopy
                    or scan of a signature.</p>
                </div>

                <p class="govuk-body">We do not accept certifications carried out by the following:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>accountant;</li>
                    <li>bank official;</li>
                    <li>legal assistant/secretary/receptionist;</li>
                    <li>post office official;</li>
                    <li>paralegal;</li>
                    <li>trainee solicitor;</li>
                    <li>teacher/lecturer/university administrator</li>
                </ul>
                <p class="govuk-body">If they add a cover sheet, it must be attached to the document. The cover sheet must also contain a specific reference to the document they have certified. If a notary public has certified the document in England and Wales, the cover sheet must be securely attached to the document e.g. book bound/metal rivet.</p>
                <p class="govuk-body">If a notary public from England, Wales or Northern Ireland signs a document for legalisation, they must also stamp or emboss the document with their notarial seal.</p>
                <p class="govuk-body">You can find:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li><a href="https://www.lawsociety.org.uk/" target="_blank" rel="noreferrer noopener">solicitors in England and Wales</a></li>
                    <li><a href="https://www.facultyoffice.org.uk/notaries/find-a-notary/" target="_blank" rel="noreferrer noopener">notaries public in England and Wales</a></li>
                    <li><a href="https://www.lawscot.org.uk/" target="_blank" rel="noreferrer noopener">solicitors and notaries public in Scotland</a></li>
                    <li><a href="https://lawsoc-ni.org/" target="_blank" rel="noreferrer noopener">solicitors and notaries public in Northern Ireland</a></li>
                </ul>
            <% } %>

            <% if (users_docs[i].doc_title.trim()=='UK Crown Dependency document' ) { %>
              <p class="govuk-body">Please find below a list of UK Crown Dependencies.</p>
              <ul class="govuk-list govuk-list--bullet">
                  <li>Bailiwick of Guernsey</li>
                  <li>Bailiwick of Jersey</li>
                  <li>Isle of Man</li>
              </ul>
              <p class="govuk-body">Your document must first have been legalised by the relevant authority in the Crown Dependency.</p>
            <% } %>

            <% if (users_docs[i].doc_title.trim()=='UK Overseas Territory document') { %>
              <p class="govuk-body">Please find below a list of UK Overseas Territories.</p>
              <ul class="govuk-list govuk-list--bullet">
                  <li>Anguilla</li>
                  <li>Bermuda</li>
                  <li>British Antarctic Territory</li>
                  <li>British Virgin Islands</li>
                  <li>Cayman Islands</li>
                  <li>Falkland Islands</li>
                  <li>Gibraltar</li>
                  <li>Montserrat</li>
                  <li>Saint Helena</li>
                  <li>Turks and Caicos Islands</li>
              </ul>
              <p class="govuk-body">Your document must first have been legalised by the relevant authority in the Overseas Territory.</p>
            <% } %>

            <fieldset class="govuk-fieldset" aria-describedby="document-certified-<%= users_docs[i].doc_id %>-hint">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
                    Has your document been certified in line with this guidance?
                </legend>
                <p id="document-certified-<%= users_docs[i].doc_id %>-hint" class="govuk-hint">Select yes if it meets all requirements above.</p>

                <div class="govuk-radios govuk-radios--inline">

                <div>
                    <div class="govuk-radios__item">
                    <input type="hidden" value="false" name="<%= users_docs[i].doc_id %>" />
                    <input class="govuk-radios__input" id="<%= users_docs[i].doc_id %>-yes" type="radio" name="<%= users_docs[i].doc_id %>" value="yes" <% if (form_values && JSON.stringify(form_values[0].yes).indexOf(users_docs[i].doc_id) > -1) {%>checked<% } %>>
                    <label class="govuk-label govuk-radios__label" for="<%= users_docs[i].doc_id %>-yes">
                        Yes
                    </label>
                    </div>
                    <div class="govuk-radios__item">
                    <input class="govuk-radios__input" id="<%= users_docs[i].doc_id %>-no" type="radio" name="<%= users_docs[i].doc_id %>" value="no" <% if (form_values && JSON.stringify(form_values[0].no).indexOf(users_docs[i].doc_id) > -1) {%>checked<% } %>>
                    <label class="govuk-label govuk-radios__label" for="<%= users_docs[i].doc_id %>-no">
                        No
                    </label>
                    </div>
                </div>
                </div>
            </fieldset>
        </fieldset>
    </div>
    <%
    }
    }
    } else {%>
    <p class="govuk-body">No documents selected require certification.</p>
    <p class="govuk-body">Please proceed to the next page.</p>
    <% } %>


    <div class="govuk-form-group">
        <p class="validation-message"></p>
        <button id="NextBtn" class="govuk-button" data-module="govuk-button">
            Continue
        </button>
    </div>

</form>
    </div>
</div>
