<% pageTitle ="Email confirmation" %>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-panel govuk-panel--confirmation govuk-!-margin-top-4">
            <h1 class="govuk-panel__title">Email sent</h1>
            <div class="govuk-panel__body">
                <span class="govuk-visually-hidden">to</span>
                <%= email %>
            </div>
        </div>

        <p class="govuk-body">We've sent the certification information to your email address.</p>
        <p class="govuk-body">
            Remember to come back to this site to submit your application when you have all of your documents certified.
        </p>

        <p class="govuk-body">
            <a
                class="govuk-link"
                href="<%= doneSurveyStandard %>"
                target="_blank"
                rel="noreferrer noopener">
                What did you think of this service?<span class="govuk-visually-hidden"> (opens in new tab)</span>
            </a>
            (takes 30 seconds)
        </p>
        <p class="govuk-body">
            <a class="govuk-link" href="/start">Start a new application</a>
        </p>
    </div>
</div>
