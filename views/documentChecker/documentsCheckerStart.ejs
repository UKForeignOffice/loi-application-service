<%
var title = return_to_skip ?"Check if documents can be legalised" :"Search for your document";
pageTitle = title;
%>

<div class="inner_header <%if (!user_data.loggedIn){%>no-user-signed-in<%}%>">
    <a href="/start?from=<%= user_data.loggedIn ? 'dashboard' : 'home' %>" class="govuk-back-link">Back</a>
    <% if (user_data.loggedIn) { %>
        <%- partial('../partials/inner-header.ejs') %>
    <% } else { %>
        <div class="inner-header-content">
            <span class="email-logout-text">
                <a href="<%= sails.config.customURLs.userServiceURL %>/sign-in?from=docChecker&next=continueDocChecker" class="govuk-link">Sign in</a>
            </span>
        </div>
    <% } %>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l govuk-!-margin-top-2">Check if documents can be legalised</h1>

    <p class="govuk-body">You can get a UK document with the signature, stamp or seal of a UK public official legalised. You may need to send your document in a particular format, for example an original not a photocopy.</p>
    <p class="govuk-body">Use this tool to check if your document can be legalised.</p>

    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            If your document does not meet our requirements and cannot be legalised, you will not be refunded.
        </strong>
    </div>

    <form action="/select-documents" method="post">
        <button id="check_documents" type="submit" class="govuk-button" data-module="govuk-button">
            Check your documents
        </button>
    </form>

    <% if (user_data.loggedIn) { %>
        <p class="govuk-body govuk-!-margin-bottom-4">If you know your documents can be legalised you can <a id="skip_document_check" class="govuk-link" href="/provide-your-details">skip this document check</a>.</p>
    <% } %>
  </div>
</div>
