<div class="govuk-form-group">
    <div id="doc-seach-typeahead">
        <label class="govuk-label" for="doc_search_field">Search for a document</label>
        <input
            class="govuk-input typeahead"
            type="search"
            id="doc_search_field"
            value="<% if (search_term && search_term!=null) { %><%= search_term %><% } %>"
            name="searchTerm"
            autocomplete="off"
            role="combobox"
            aria-autocomplete="list">
        <button type="submit" id="doc_search_button" class="govuk-button" data-module="govuk-button">
            Search
        </button>
    </div>
</div>
