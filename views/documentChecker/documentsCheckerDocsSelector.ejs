<% pageTitle ="Search and select your documents" %>

<%if(error_report && error_report.length>0){
    pageTitle ="Error: Search and select your documents"
} %>

<%  if (filtered_documents.length > 0) { skip_to_search = {link: '#docs_table', message: 'Skip to document search results'}}%>

<%
var sessionExpiry = new Date(session).toUTCString();
%>
<script>var sessionExpiry = new Date("<%= session%>").toUTCString();
    var search_history = ("null<%= search_history%>").split(",");
</script>

<div class="inner_header <%if (!user_data.loggedIn){%>no-user-signed-in<%}%>" >
    <%if(search_history && search_history.length>1){ %><a id="document-search-back" href="/select-documents?back=true" class="govuk-back-link">Back</a>
    <%}else if (req.session.appType == 2){%><a id="document-search-back-premium" href="/business-document-quantity?pk_campaign=Premium-Service&pk_kwd=Premium" class="govuk-back-link">Back</a>
    <%}else if (req.session.appType == 3){%><a id="document-search-back-dropoff" href="/business-document-quantity?pk_campaign=DropOff-Service&pk_kwd=DropOff" class="govuk-back-link">Back</a>
  <%}else{%><a id="document-search-back" href="/check-documents" class="govuk-back-link">Back</a> <%}%>


    <%
    //User email and logout link
    if (user_data.loggedIn) { %>
    <%- partial ('../partials/inner-header.ejs')%>
    <% } else { %>
    <div class="inner-header-content">
        <span class="email-logout-text">
            <a href="<%= sails.config.customURLs.userServiceURL %>/sign-in?from=docChecker&next=continueDocChecker" class="govuk-link">Sign in</a>
        </span>
    </div>
    <% } %>
</div>

<% var hasErrors = Boolean(error_report && error_report.length > 0); %>
<% var full_width_layout = true; %>

<style>
  #documents-checker-selector .filter-results,
  #documents-checker-selector .document-basket,
  #documents-checker-selector #doc-table,
  #documents-checker-selector #basket-table {
    width: 100% !important;
  }

  #documents-checker-selector .document-basket {
    float: none !important;
    clear: both;
  }
</style>

<div id="documents-checker-selector">
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl" id="select-your-documents">Search and select your documents</h1>

        <% if (hasErrors) { %>
            <div
                id="error-details"
                class="govuk-error-summary"
                role="alert"
                aria-labelledby="error-summary-title"
                tabindex="-1"
                data-module="govuk-error-summary">
                <h2 class="govuk-error-summary__title" id="error-summary-title">
                    There is a problem
                </h2>

                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li>
                            You can only select up to <%= maxNumOfDocuments%> documents
                        </li>
                    </ul>
                </div>
            </div>
        <% } %>

        <!-- ARIA live region -->
        <div id="sr-notification-container" class="govuk-visually-hidden" aria-live="assertive" aria-atomic="true"></div>

        <!-- Search field -->
        <form id="documentFilter" action="/select-documents" method="get">
            <p class="govuk-body">Start typing to search for the documents you want to legalise. If you do not know the document name, check the <a class="govuk-link" href="/a-to-z-document-listing">full list of documents we can legalise</a>.</p>
            <p class="govuk-body">Once you have found the document, select it. You can then search for and add more documents if you need to.</p>
            <p class="govuk-body">This list is not exhaustive. If you cannot find your document in this list, contact <a class="govuk-link" href="mailto:legalisation@fcdo.gov.uk">legalisation@fcdo.gov.uk</a> with a scan or photo of your document.</p>
            <div class="govuk-inset-text">
                If your document was issued in a former UK controlled territory, a foreign diplomatic mission in the UK, a UK Overseas Territory, or a UK Crown Dependency, your document must be presented to the local authority in the country of issue to be legalised.
            </div>
            <%- partial('documentsCheckerSearch', {search_term:search_term})%>
        </form>

        <div class="document-search-top-searches" id="document-search-top-searches">
            <p class="govuk-body govuk-!-margin-bottom-2"><strong>Top searches</strong></p>
            <p class="govuk-body-s govuk-!-margin-bottom-6 top-searches">
                <a class="govuk-link" href="?searchTerm=civil%20record"><span class="govuk-visually-hidden">Search for </span>Civil record (birth, death, marriage certificate)</a>,
                <a class="govuk-link" href="?searchTerm=companies%20house"><span class="govuk-visually-hidden">Search for </span>Companies House</a>,
                <a class="govuk-link" href="?searchTerm=criminal%20record"><span class="govuk-visually-hidden">Search for </span>Criminal record</a>,
                <a class="govuk-link" href="?searchTerm=court%20documents"><span class="govuk-visually-hidden">Search for </span>Court documents</a>,
                <a class="govuk-link" href="?searchTerm=medical%20documents"><span class="govuk-visually-hidden">Search for </span>Medical documents</a>,
                <a class="govuk-link" href="?searchTerm=identification%20documents"><span class="govuk-visually-hidden">Search for </span>Identification documents</a>,
                <a class="govuk-link" href="?searchTerm=educational"><span class="govuk-visually-hidden">Search for </span>Educational documents</a>
            </p>
        </div>

        <div class="filtering">
            <%- partial('documentCheckerResults', {full_width_layout: full_width_layout})%>
        </div>

        <div class="follow-scroll" id="shopping_basket_container">
            <%- partial('documentsCheckerBasket', {search_term:search_term, selected_docs:selected_docs, source:'', full_width_layout: full_width_layout})%>
        </div>

        <form action="/confirm-documents" id="yourDocuments" method="post" style="clear: both;">
            <div class="govuk-form-group">
                <input type="submit" id="NextBtn" class="govuk-button <%if (selected_docs.documents.length<1) { %>hide<% } %>" value="Continue" />
            </div>
        </form>
    </div>
</div>
</div>
