<% pageTitle ="Check your documents are eligible" %>
<% const errorMessage = page_error === true ?"You must answer this question" : page_error %>

<div class="inner_header <% if (!user_data.loggedIn) { %>no-user-signed-in<% } %>">

    <a href="/before-you-apply" class="govuk-back-link">Back</a>

    <% if (user_data.loggedIn) { %>
        <%- partial('../partials/inner-header.ejs') %>
    <% } else { %>
        <div class="inner-header-content">
            <span class="email-logout-text">
                <a href="<%= sails.config.customURLs.userServiceURL %>/sign-in?next=serviceSelector&from=start"
                   class="govuk-link">Sign in</a>
            </span>
        </div>
    <% } %>

</div>

<div>
    <% if (Boolean(errorMessage)) { %>
        <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" tabindex="-1"
             data-module="govuk-error-summary">
            <h2 class="govuk-error-summary__title" id="error-summary-title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>
                        <a href="#no-option-chosen-error"><%= errorMessage %></a>
                    </li>
                </ul>
            </div>
        </div>
    <% } %>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <span class="caption-xlarge">e-Apostille suitability - 1 of 3</span>

            <h1 class="govuk-heading-l govuk-!-margin-top-2">
                Check your documents are eligible
            </h1>

            <p class="govuk-body">
                The e-Apostille service excludes a small number of document types.
                To legalise the following documents,
                <a class="govuk-link" href="/select-service">use the paper-based service instead</a>.
            </p>

            <h2 class="govuk-heading-s govuk-!-margin-bottom-2">
                Excluded documents
            </h2>

            <ul class="govuk-list govuk-list--bullet indent-list govuk-!-margin-bottom-0">
                <li>All General Register Office (GRO) documents, including birth, death, marriage, civil partnership and adoption certificates</li>
                <li>ACRO police certificates for England and Wales</li>
                <li>Disclosure Barring Service (DBS) certificates for England and Wales</li>
                <li>Disclosure certificates for Scotland or Northern Ireland</li>
                <li>Fingerprint certificates</li>
                <li>Association of Chartered Certified Accountants (ACCA) membership certificates</li>
            </ul>

            <details class="govuk-details">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">
                        Why these documents are excluded
                    </span>
                </summary>
                <div class="govuk-details__text">
                    The organisations that issue these documents do not currently allow electronic copies to be legalised.
                    For example, some of the documents include physical features and therefore must be viewed in their original format.
                </div>
            </details>

            <form action="/eligibility/check-documents-are-eligible" method="post">

                <div class="govuk-form-group<% if (Boolean(errorMessage)) { %> govuk-form-group--error<% } %>">
                    <fieldset class="govuk-fieldset" aria-describedby="<% if (Boolean(errorMessage)) { %>no-option-chosen-error<% } %>">
                        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                            <h2 class="govuk-fieldset__heading">Are your documents eligible for the e-Apostille service?</h2>
                        </legend>
                        <% if (Boolean(errorMessage)) { %>
                            <span id="no-option-chosen-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error: </span><%= errorMessage %>
                            </span>
                        <% } %>
                        <div class="govuk-radios">
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input"
                                       id="eapostille-acceptable"
                                       name="eapostille-acceptable"
                                       type="radio"
                                       value="yes">
                                <label class="govuk-label govuk-radios__label" for="eapostille-acceptable">
                                    Yes, I believe my documents are eligible
                                </label>
                            </div>

                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input"
                                       id="eapostille-acceptable-2"
                                       name="eapostille-acceptable"
                                       type="radio"
                                       value="no">
                                <label class="govuk-label govuk-radios__label" for="eapostille-acceptable-2">
                                    No, my documents are excluded
                                </label>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <button class="govuk-button govuk-!-margin-top-6" data-module="govuk-button">
                    Continue
                </button>
            </form>
        </div>
    </div>
</div>
