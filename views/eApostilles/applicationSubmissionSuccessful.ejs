<% pageTitle="Application submitted" %>

<div class="inner_header no-user-signed-in">
    <%- partial('../partials/inner-header.ejs') %>
</div>

<div class="govuk-grid-row">
    <div class="govuk-!-margin-bottom-6">
        <div class="govuk-panel govuk-panel--confirmation container-confirmed container">
            <h1 class="govuk-panel__title confirmed govuk-!-padding-top-5">
                <i class="flaticon-checked21" aria-hidden="true"></i>
                Application submitted
            </h1>
            <div class="govuk-panel__body govuk-!-padding-bottom-5">
                Application reference<br>
                <strong><%= applicationId %></strong>
            </div>
        </div>
    </div>
</div>

<div class="govuk-grid-row">
    <section class="govuk-grid-column-two-thirds">
        <div class="govuk-inset-text govuk-!-margin-top-6 govuk-!-margin-bottom-0">
            <p class="govuk-body govuk-!-margin-bottom-0"><strong>Email confirmation sent to:</strong> <%= email %></p>
        </div>

        <h2 class="govuk-heading-l">
            What happens next
        </h2>

        <p class="govuk-body">
            Your application will be processed within <%= sails.config.views.locals.numOfWorkingDaysEapp %> working days.
        </p>
        <p class="govuk-body">
            We will email you when your legalised documents are available to download from your account.
        </p>
        <p class="govuk-body">
            <a href="/dashboard" class="govuk-link">View applications</a>
        </p>
        <p class="govuk-body">
            <a href="/select-service" class="govuk-link">Start new application</a>
        </p>
        <p class="govuk-body">
            <a href="<%= sails.config.views.locals.doneSurveyEapostille %>" target="_blank" rel="noreferrer noopener" class="govuk-link">What did you think of this service?</a> (takes 30 seconds)
        </p>
    </section>
</div>
