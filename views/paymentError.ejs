<% pageTitle ="Payment error" %>
<div class="inner_header <%if (!user_data.loggedIn){%>no-user-signed-in<%}%>" >
    <%- partial ('./partials/inner-header.ejs')%>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Start a new application</h1>
        <p class="govuk-body">Sorry, we can't take payment for this application and you’ll need to start again. This may be because you’ve used the browser back button immediately after completing a previous application. Use the link below to start again.</p>
        <a href="/start?from=select-service" id="start" role="button" draggable="false" class="govuk-button" data-module="govuk-button">Start a new application</a>
    </div>
</div>
