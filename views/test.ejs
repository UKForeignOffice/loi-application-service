<% pageTitle ="Test" %>
<div class="govuk-grid-row">
    <section class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Test</h1>

        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--m">Download test files</caption>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">Test Receipt</th>
                    <td class="govuk-table__cell govuk-table__cell--numeric">
                        <a class="govuk-button govuk-button--secondary govuk-!-margin-0" href="/download-orbit-receipt" download="LegalisedReceipt.pdf">
                            Download
                        </a>
                    </td>
                </tr>
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">Test Apostille</th>
                    <td class="govuk-table__cell govuk-table__cell--numeric">
                        <a class="govuk-button govuk-button--secondary govuk-!-margin-0" href="/download-orbit-apostille" download="LegalisedApostille.pdf">
                            Download
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
</div>
