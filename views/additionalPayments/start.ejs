<%
var hasErrors = Array.isArray(errors) && errors.length > 0;
pageTitle = hasErrors ?"Error: Additional Payments" :"Additional Payments";
var hasCostError = (costError === true) || (costErrorAmount === true);
%>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl govuk-!-margin-top-4">Make an additional payment for legalisation</h1>

        <% if (hasErrors) {%>
            <div class="govuk-error-summary" id="error-details" aria-labelledby="error-summary-title" role="alert" tabindex="-1" data-module="govuk-error-summary">
                <h2 class="govuk-error-summary__title" id="error-summary-title">
                    There is a problem
                </h2>
                <div class="govuk-error-summary__body" id="all-errors">
                    <% if (errors[0].msg) { %>
                        <ul class="govuk-list govuk-error-summary__list">
                            <% for (var i = 0; i < errors.length; i++) { %>
                                <li><a href="#<%= errors[i].questionId %>"><%= errors[i].msg %></a></li>
                            <% } %>
                        </ul>
                    <% } %>
                </div>
            </div>
        <%}%>

        <p class="govuk-body">This page is for making additional payments for existing applications. For example, to pay for an extra document or to pay the correct amount of postage.</p>
        <p class="govuk-inset-text">To submit a new application use the <a class="govuk-link" href="https://www.gov.uk/get-document-legalised">legalisation online application service</a> instead.</p>

        <form id="additional-payments-form" method="post" action="/additional-payments/confirm">
            <div class="govuk-form-group<% if (hasCostError) { %> govuk-form-group--error<% } %>" id="legend_cost">
                <label class="govuk-label govuk-label--m" for="applicationAmount">How much extra do you need to pay?</label>
                <div id="applicationAmount-hint" class="govuk-hint">Enter the amount which you've been told to pay by the Legalisation Office.</div>
                <% if (costError === true){%>
                    <p id="cost-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> Please enter a payment amount
                    </p>
                <% } else if (costErrorAmount === true){%>
                    <p id="cost-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> Amount must be between £3 and £4000
                    </p>
                <% } %>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input
                        class="govuk-input govuk-input--width-5<% if (hasCostError) { %> govuk-input--error<% } %>"
                        id="applicationAmount"
                        name="applicationAmount"
                        type="text"
                        inputmode="decimal"
                        spellcheck="false"
                        aria-describedby="applicationAmount-hint<% if (hasCostError) { %> cost-error<% } %>"
                        <% if (req.session.additionalPayments) {%>value="<%= req.session.additionalPayments.applicationAmount %>"<%} else {%> value="<%= applicationAmount %>" <% }%>>
                </div>
            </div>

            <div class="govuk-form-group<% if (emailError === true) {%> govuk-form-group--error<% } %>" id="legend_email">
                <label class="govuk-label govuk-label--m" for="applicationEmail">What is your email address?</label>
                <div id="applicationEmail-hint" class="govuk-hint">Enter your email so we can send you a payment confirmation.</div>
                <% if (emailError === true){%>
                    <p id="email-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> Please enter a correctly formatted email address.
                    </p>
                <% } %>
                <input
                    type="email"
                    class="govuk-input govuk-!-width-two-thirds<% if (emailError === true) { %> govuk-input--error<% } %>"
                    id="applicationEmail"
                    name="applicationEmail"
                    autocomplete="email"
                    spellcheck="false"
                    aria-describedby="applicationEmail-hint<% if (emailError === true) { %> email-error<% } %>"
                    <% if (req.session.additionalPayments) {%>value="<%= req.session.additionalPayments.applicationEmail %>"<%} else {%> value="<%= applicationEmail %>" <% }%>>
            </div>

            <input type="hidden" id="applicationRef" name="applicationRef" <% if (req.session.additionalPayments) {%>value="<%= req.session.additionalPayments.applicationRef %>"<%} else {%> value="<%= applicationRef %>" <% }%>>
            <button type="submit" id="NextBtn" class="govuk-button" data-module="govuk-button">Continue</button>
        </form>
    </div>
</div>

<% errors = [] %>
