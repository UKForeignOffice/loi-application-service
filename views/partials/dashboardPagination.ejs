<p class="govuk-body">
    <%= paginationMessage %>
</p>

<% if (totalPages > 1) { %>
    <nav class="govuk-pagination" aria-label="Pagination">
        <% if (currentPage > 1) { %>
            <div class="govuk-pagination__prev">
                <a class="govuk-link govuk-pagination__link" href="/dashboard?searchText=<%= searchCriteria %>&sortOrder=<%= sortOrder %>&page=<%= parseInt(currentPage) - 1 %>" rel="prev">
                    <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                        <path d="m6.5938 0.0078125-6.5938 6.4922 6.5938 6.5 1.4062-1.4062-4.1875-4.0938h11.187v-2h-11.188l4.1875-4.0938z"></path>
                    </svg>
                    <span class="govuk-pagination__link-title">
                        Previous
                    </span>
                    <span class="govuk-visually-hidden"> page</span>
                </a>
            </div>
        <% } %>

        <ul class="govuk-pagination__list">
            <% for (i = 1; i <= totalPages; i++) { %>
                <% if (parseInt(currentPage) === i) { %>
                    <li class="govuk-pagination__item govuk-pagination__item--current">
                        <a class="govuk-link govuk-pagination__link" href="/dashboard?searchText=<%= searchCriteria %>&sortOrder=<%= sortOrder %>&page=<%= i %>" aria-current="page">
                            <span class="govuk-visually-hidden">Page </span><%= i %>
                        </a>
                    </li>
                <% } else { %>
                    <li class="govuk-pagination__item">
                        <a class="govuk-link govuk-pagination__link" href="/dashboard?searchText=<%= searchCriteria %>&sortOrder=<%= sortOrder %>&page=<%= i %>">
                            <span class="govuk-visually-hidden">Page </span><%= i %>
                        </a>
                    </li>
                <% } %>
            <% } %>
        </ul>

        <% if (totalPages > currentPage) { %>
            <div class="govuk-pagination__next">
                <a class="govuk-link govuk-pagination__link" href="/dashboard?searchText=<%= searchCriteria %>&sortOrder=<%= sortOrder %>&page=<%= parseInt(currentPage) + 1 %>" rel="next">
                    <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                        <path d="m8.4062 0.0078125-1.4062 1.4062 4.1875 4.0938h-11.188v2h11.188l-4.1875 4.0938 1.4062 1.4062 6.5938-6.5z"></path>
                    </svg>
                    <span class="govuk-pagination__link-title">
                        Next
                    </span>
                    <span class="govuk-visually-hidden"> page</span>
                </a>
            </div>
        <% } %>
    </nav>
<% } %>
