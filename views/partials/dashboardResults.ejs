<% const safeSearchCriteria = searchCriteria || ''; %>

<div class="govuk-form-group govuk-!-margin-bottom-4">
    <form id="dashboard-search-table-form" method="post" action="/dashboard" class="govuk-!-margin-bottom-0">
        <label for="dashboard-search-filter" class="govuk-label govuk-visually-hidden">Search by reference or service</label>
        <input
            class="govuk-input govuk-!-width-one-third"
            id="dashboard-search-filter"
            name="dashboardFilter"
            type="text"
            value="<%= safeSearchCriteria %>"
            placeholder="Search by reference or service"
            autocomplete="off">
        <button class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button" type="submit">Search</button>
        <% if (safeSearchCriteria) { %>
            <a class="govuk-link govuk-!-margin-left-2" href="/dashboard?clearSearchResults" id="dashboard-clear-results">Clear search filter</a>
        <% } %>
    </form>
</div>

<table class="govuk-table govuk-!-margin-top-4">
    <caption class="govuk-visually-hidden">
        Application <% if (safeSearchCriteria) { %>search results<% } else { %>history<% } %> table. Can be sorted by clicking the table headers.
    </caption>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">
                <a id="sortSubmitted" class="sortableHeader govuk-link<% if (sortOrder == 1) { %> headerSortDown<% } %><% if (sortOrder == -1) { %> headerSortUp<% } %>" href="/dashboard?searchText=<%= safeSearchCriteria %>&sortOrder=<% if (sortOrder == 1) { %>-<% } %>1">
                    Submitted
                    <span class="govuk-visually-hidden"><% if (sortOrder == 1) { %> ascending<% } %><% if (sortOrder == -1) { %> descending<% } %></span>
                </a>
            </th>
            <th scope="col" class="govuk-table__header">
                <a id="sortAppRef" class="sortableHeader govuk-link<% if (sortOrder == 2) { %> headerSortDown<% } %><% if (sortOrder == -2) { %> headerSortUp<% } %>" href="/dashboard?searchText=<%= safeSearchCriteria %>&sortOrder=<% if (sortOrder == 2) { %>-<% } %>2">
                    <span class="hide-col-sm hide-col-md">Application reference</span>
                    <span class="show-col-sm show-col-md">Reference</span>
                    <span class="govuk-visually-hidden"><% if (sortOrder == 2) { %> ascending<% } %><% if (sortOrder == -2) { %> descending<% } %></span>
                </a>
            </th>
            <th scope="col" class="govuk-table__header hide-col-sm hide-col-md">
                <a id="sortUserRef" class="sortableHeader govuk-link<% if (sortOrder == 6) { %> headerSortDown<% } %><% if (sortOrder == -6) { %> headerSortUp<% } %>" href="/dashboard?searchText=<%= safeSearchCriteria %>&sortOrder=<% if (sortOrder == 6) { %>-<% } %>6">
                    Your reference
                    <span class="govuk-visually-hidden"><% if (sortOrder == 6) { %> ascending<% } %><% if (sortOrder == -6) { %> descending<% } %></span>
                </a>
            </th>
            <th scope="col" class="govuk-table__header">
                <a id="sortCost" class="sortableHeader govuk-link<% if (sortOrder == 5) { %> headerSortDown<% } %><% if (sortOrder == -5) { %> headerSortUp<% } %>" href="/dashboard?searchText=<%= safeSearchCriteria %>&sortOrder=<% if (sortOrder == 5) { %>-<% } %>5">
                    Cost
                    <span class="govuk-visually-hidden"><% if (sortOrder == 5) { %> ascending<% } %><% if (sortOrder == -5) { %> descending<% } %></span>
                </a>
            </th>
            <th scope="col" class="govuk-table__header hide-col-sm hide-col-md">
                <a id="sortService" class="sortableHeader govuk-link<% if (sortOrder == 3) { %> headerSortDown<% } %><% if (sortOrder == -3) { %> headerSortUp<% } %>" href="/dashboard?searchText=<%= safeSearchCriteria %>&sortOrder=<% if (sortOrder == 3) { %>-<% } %>3">
                    Service
                    <span class="govuk-visually-hidden"><% if (sortOrder == 3) { %> ascending<% } %><% if (sortOrder == -3) { %> descending<% } %></span>
                </a>
            </th>
            <th scope="col" class="govuk-table__header">Status</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        <% for (let i = 0; i < users_applications.length; i++) { %>
            <% const app = users_applications[i]; %>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell appDate">
                    <%= dayjs(app.createdDate).format('DD-MM-YYYY') %>
                </td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" data-testid="eApp-ref-link" href="<%= app.view_app_url %>">
                        <%= app.unique_app_id %>
                    </a>
                </td>
                <td class="govuk-table__cell hide-col-sm hide-col-md">
                    <%= app.user_ref || 'Not available' %>
                </td>
                <td class="govuk-table__cell">
                    £<%= parseFloat(app.payment_amount + 0).toFixed(2) %>
                </td>
                <td class="govuk-table__cell hide-col-sm hide-col-md">
                    <%= app.applicationtype %>
                </td>
                <td class="govuk-table__cell">
                    <strong class="govuk-tag <%= app.app_status.colorClass %>">
                        <%= app.app_status.text %>
                    </strong>
                    <div class="govuk-!-margin-top-1">
                        <% if (app.app_status.text === 'Completed' && app.rejected_docs > 0) { %>
                            <span class="govuk-body-s">
                                <%= app.rejected_docs %> PDF<% if (app.rejected_docs > 1) { %>s<% } %> rejected
                            </span>
                        <% } %>
                        <% if (app.tracking_ref) { %>
                            <% if (app.main_postcode) { %>
                                <a class="govuk-link" href="https://www.dxdelivery.com/?tn=<%= app.tracking_ref %>&tpc=<%= app.main_postcode %>" target="_blank" rel="noopener noreferrer">
                                    Tracking ref: <%= app.tracking_ref %>
                                </a>
                            <% } else { %>
                                <a class="govuk-link" href="https://www.dxdelivery.com/consumer/my-tracking/" target="_blank" rel="noopener noreferrer">
                                    Tracking ref: <%= app.tracking_ref %>
                                </a>
                            <% } %>
                        <% } %>
                    </div>
                </td>
            </tr>
        <% } %>
    </tbody>
</table>

<div>
    <%- partial('./dashboardPagination.ejs', { paginationMessage, totalPages, currentPage, searchCriteria, sortOrder }) %>
</div>
