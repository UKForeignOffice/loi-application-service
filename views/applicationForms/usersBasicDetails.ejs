<%
var link ="/check-documents-important-information";
var isLoggedIn = user_data && user_data.loggedIn;
var hasErrors = Array.isArray(error_report) &&
    error_report[0] && error_report[0][0] &&
    Array.isArray(error_report[0][0].errMsgs);
var errMsgs = hasErrors ? error_report[0][0].errMsgs : [];
var erroneousFields = (Array.isArray(error_report) &&
    error_report[1] && error_report[1][0] &&
    Array.isArray(error_report[1][0].erroneousFields))
    ? error_report[1][0].erroneousFields
    : [];

if (isLoggedIn) {
    link ="/your-basic-details?use_saved_details=true";
} else if (summary) {
    link ="/review-summary";
} else if (selected_docs && selected_docs.totalQuantity > 0 && last_doc_checker_page) {
    link = last_doc_checker_page;
}

pageTitle = hasErrors ?"Error: Your details" :"Your details";

function hasFieldError(fieldId) {
    return erroneousFields.indexOf(fieldId) > -1;
}

function getFieldErrors(fieldId) {
    return errMsgs.filter(function (error) {
        return error.questionId === fieldId;
    });
}
%>

<div class="inner_header <% if (!isLoggedIn) { %>no-user-signed-in<% } %>">
    <a href="<%= link %>" class="govuk-back-link">Back</a>
    <% if (isLoggedIn) { %>
        <%- partial("../partials/inner-header.ejs") %>
    <% } else { %>
        <div class="inner-header-content">
            <span class="email-logout-text">
                <a href="<%= sails.config.customURLs.userServiceURL %>/sign-in?next=serviceSelector&from=start" class="govuk-link">Sign in</a>
            </span>
        </div>
    <% } %>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <% if (hasErrors) { %>
            <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" tabindex="-1" data-module="govuk-error-summary">
                <h2 class="govuk-error-summary__title" id="error-summary-title">
                    There is a problem
                </h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <% errMsgs.forEach(function (errorMsg) { %>
                            <li><a href="#<%= errorMsg.questionId %>"><%= errorMsg.fieldSolution %></a></li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        <% } %>

        <h1 class="govuk-heading-xl">Your details</h1>

        <form action="<%= !update ? '/your-basic-details/confirm' : '/modify-your-basic-details/success' %>" id="yourDetailsForm" method="post">
            <div class="govuk-form-group<% if (hasFieldError('first_name')) { %> govuk-form-group--error<% } %>">
                <label class="govuk-label" for="first_name">First name</label>
                <% getFieldErrors("first_name").forEach(function (error) { %>
                    <p class="govuk-error-message" id="first_name-error">
                        <span class="govuk-visually-hidden">Error:</span> <%= error.fieldSolution %>
                    </p>
                <% }) %>
                <input class="govuk-input govuk-!-width-one-half<% if (hasFieldError('first_name')) { %> govuk-input--error<% } %>" id="first_name" type="text" autocomplete="given-name" name="first_name" <% if (submit_status === true) { %>disabled="disabled"<% } %> value="<%= form_values && form_values.first_name ? form_values.first_name : '' %>">
            </div>

            <div class="govuk-form-group<% if (hasFieldError('last_name')) { %> govuk-form-group--error<% } %>">
                <label class="govuk-label" for="last_name">Last name</label>
                <% getFieldErrors("last_name").forEach(function (error) { %>
                    <p class="govuk-error-message" id="last_name-error">
                        <span class="govuk-visually-hidden">Error:</span> <%= error.fieldSolution %>
                    </p>
                <% }) %>
                <input class="govuk-input govuk-!-width-one-half<% if (hasFieldError('last_name')) { %> govuk-input--error<% } %>" id="last_name" type="text" autocomplete="family-name" name="last_name" <% if (submit_status === true) { %>disabled="disabled"<% } %> value="<%= form_values && form_values.last_name ? form_values.last_name : '' %>">
            </div>

            <div class="govuk-form-group<% if (hasFieldError('mobileNo')) { %> govuk-form-group--error<% } %>">
                <label class="govuk-label" for="mobileNo">Mobile number</label>
                <% getFieldErrors("mobileNo").forEach(function (error) { %>
                    <p class="govuk-error-message" id="mobileNo-error">
                        <span class="govuk-visually-hidden">Error:</span> <%= error.fieldSolution %>
                    </p>
                <% }) %>
                <input type="tel" id="mobileNo" class="govuk-input govuk-!-width-one-half<% if (hasFieldError('mobileNo')) { %> govuk-input--error<% } %>" autocomplete="tel-national" name="mobileNo" <% if (submit_status === true) { %>disabled="disabled"<% } %> value="<%= form_values && form_values.mobileNo != null ? form_values.mobileNo.replace(/\s/g, '') : '' %>">
            </div>

            <div class="govuk-form-group<% if (hasFieldError('telephone')) { %> govuk-form-group--error<% } %>">
                <label class="govuk-label" for="telephone">Secondary phone number (optional)</label>
                <% getFieldErrors("telephone").forEach(function (error) { %>
                    <p class="govuk-error-message" id="telephone-error">
                        <span class="govuk-visually-hidden">Error:</span> <%= error.fieldSolution %>
                    </p>
                <% }) %>
                <input type="tel" id="telephone" class="govuk-input govuk-!-width-one-half<% if (hasFieldError('telephone')) { %> govuk-input--error<% } %>" autocomplete="tel" name="telephone" <% if (submit_status === true) { %>disabled="disabled"<% } %> value="<%= form_values && form_values.telephone ? form_values.telephone : '' %>">
            </div>

            <input id="has_email" name="has_email" type="hidden" value="yes">

            <div class="govuk-form-group<% if (hasFieldError('email')) { %> govuk-form-group--error<% } %>">
                <label class="govuk-label" for="email">Email address</label>
                <p class="govuk-hint" id="email-hint">We will send confirmation of your application here</p>
                <% getFieldErrors("email").forEach(function (error) { %>
                    <p class="govuk-error-message" id="email-error">
                        <span class="govuk-visually-hidden">Error:</span> <%= error.fieldSolution %>
                    </p>
                <% }) %>
                <input class="govuk-input govuk-!-width-one-half<% if (hasFieldError('email')) { %> govuk-input--error<% } %>" id="email" type="email" inputmode="email" autocomplete="email" name="email" aria-describedby="email-hint<% if (hasFieldError('email')) { %> email-error<% } %>" <% if (submit_status === true) { %>disabled="disabled"<% } %> value="<%= form_values && form_values.email != null ? form_values.email : '' %>">
            </div>

            <div class="govuk-form-group<% if (hasFieldError('confirm_email')) { %> govuk-form-group--error<% } %>">
                <label class="govuk-label" for="confirm_email">Confirm email address</label>
                <% getFieldErrors("confirm_email").forEach(function (error) { %>
                    <p class="govuk-error-message" id="confirm_email-error">
                        <span class="govuk-visually-hidden">Error:</span> <%= error.fieldSolution %>
                    </p>
                <% }) %>
                <input class="govuk-input govuk-!-width-one-half<% if (hasFieldError('confirm_email')) { %> govuk-input--error<% } %>" id="confirm_email" type="email" inputmode="email" autocomplete="off" name="confirm_email" <% if (submit_status === true) { %>disabled="disabled"<% } %> value="<%= form_values && form_values.confirm_email != null ? form_values.confirm_email : '' %>">
            </div>

            <button type="submit" id="NextBtn" class="govuk-button govuk-!-margin-top-6" data-module="govuk-button">
                <%= !summary ?"Continue" :"Save and return to summary" %>
            </button>
        </form>
    </div>
</div>
