<% pageTitle ="Returning us your documents" %>

<% if (error_report && error_report.length > 0) {
    pageTitle ="Error: Returning us your documents"
} %>

<div class="inner_header <% if (!user_data.loggedIn) { %>no-user-signed-in<% } %>">
    <%
    if (typeof(countryHasChanged) == 'undefined') { countryHasChanged = false }
    if (!countryHasChanged) {
        var url = !summary ? '/postage-send-options' : '/review-summary' ; %>
    <a href="<%= url%>" class="govuk-back-link">Back</a>
    <% } %>
    <%//User email and logout link
    if (user_data.loggedIn) { %>
    <%- partial ('../partials/inner-header.ejs')%>
    <% } %>
</div>

<% var hasError = Boolean(error_report); %>
<% var hasSingleReturnOption = return_postages.length == 1; %>

<% if (hasError) { %>
<div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" tabindex="-1" data-module="govuk-error-summary">
    <h2 class="govuk-error-summary__title" id="error-summary-title">
        There is a problem
    </h2>
    <div class="govuk-error-summary__body">
        <ul class="govuk-list govuk-error-summary__list">
            <li><a href="#return-postage-error">Choose a postage option</a></li>
        </ul>
    </div>
</div>
<% } %>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl">Returning your documents</h1>

        <% if (countryHasChanged) { %>
        <div class="govuk-inset-text govuk-!-margin-top-0" id="country-has-changed">
            Because you have changed your return address for the documents you are legalising, the return postage options available have also changed.
        </div>
        <% } %>

        <form action="/submit-postage-return-options" id="return_address" method="post">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-form-group<% if (hasError) { %> govuk-form-group--error<% } %>">
                        <% if (hasSingleReturnOption) { %>
                        <input id="<%= return_postages[0].type %>" name="return_postage" type="hidden" value="<%= return_postages[0].id %>">
                        <p class="govuk-body">
                            We'll return your legalised documents and any supporting documentation by <%= return_postages[0].pretty_title %>.
                            The courier cost is <strong>£<%= parseFloat(return_postages[0].price).toFixed(2) %></strong>.
                        </p>
                        <p class="govuk-body"><%= helptext.courier.line1 %></p>
                        <% } else { %>
                        <fieldset class="govuk-fieldset" aria-describedby="<% if (hasError) { %>return-postage-error<% } %>">
                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                                <h2 class="govuk-fieldset__heading">Select a delivery method for the return of your documents</h2>
                            </legend>

                            <% if (hasError) { %>
                            <p id="return-postage-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error: </span>Choose a postage option
                            </p>
                            <% } %>

                            <div class="govuk-radios">
                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input" data-target="option1Help"
                                           id="<%= return_postages[1].type + '_' + 1 %>"
                                           type="radio"
                                           <% if (form_values && return_postages[1].id == form_values) { %>checked<% } %>
                                           name="return_postage" value="<%= return_postages[1].id %>">
                                    <label class="govuk-label govuk-radios__label" for="<%= return_postages[1].type + '_' + 1 %>">
                                        <%= return_postages[1].title %><% if (return_postages[1].price != 0) { %> - £<%= parseFloat(return_postages[1].price).toFixed(2) %><% } %>
                                    </label>
                                </div>

                                <div class="govuk-inset-text js-hidden"
                                     <% if (form_values && return_postages[1].id == form_values){ %>aria-hidden="false" style="display: block;"<% } %>
                                     id="option1Help">
                                    <p class="govuk-body govuk-!-margin-0"><%= helptext.courier.line1 %></p>
                                </div>

                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input" data-target="option2Help"
                                           id="<%= return_postages[0].type + '_' + 0 %>"
                                           type="radio"
                                           <% if (form_values && return_postages[0].id == form_values) { %>checked<% } %>
                                           name="return_postage" value="<%= return_postages[0].id %>">
                                    <label class="govuk-label govuk-radios__label" for="<%= return_postages[0].type + '_' + 0 %>">
                                        <%= return_postages[0].title %><% if (return_postages[0].price != 0) { %> - £<%= parseFloat(return_postages[0].price).toFixed(2) %><% } %>
                                    </label>
                                </div>
                            </div>
                        </fieldset>
                        <% } %>
                    </div>

                </div>
            </div>

            <% if (!hasSingleReturnOption) { %>
            <div class="govuk-inset-text js-hidden"
                 <% if (form_values && return_postages[0].id == form_values){ %>aria-hidden="false" style="display: block;"<% } %>
                 id="option2Help">
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-half">
                        <p class="govuk-body"><%= helptext.sae.line1 %><br/><%= helptext.sae.line2 %></p>
                        <ul class="govuk-list govuk-list--bullet">
                            <li><%= helptext.sae.line3 %></li>
                            <li><%= helptext.sae.line4 %></li>
                            <li><%= helptext.sae.line5 %><a href="<%= helptext.sae.linkURL %>" target="_blank" rel="noopener noreferrer" id="return-options-royal-mail-link"><%= helptext.sae.linkText %></a></li>
                            <li><%= helptext.sae.line6 %></li>
                        </ul>
                        <p class="govuk-body"><%= helptext.sae.line7 %><br/><%= helptext.sae.line8 %></p>
                    </div>
                    <div class="govuk-grid-column-one-half">
                        <img style="max-width: 100%" src="images/SAE-7.png" alt="Illustration of self-addressed envelope"/>
                    </div>
                </div>
            </div>
            <% } %>

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <button type="submit" id="NextBtn" class="govuk-button" data-module="govuk-button">
                        <% if (!summary) { %>Continue<% } else { %>Save and return to summary<% } %>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
