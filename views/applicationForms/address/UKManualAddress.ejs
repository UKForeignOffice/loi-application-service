<% if(address_type == 'main') {
    if(error_report && error_report.length>0) {
        pageTitle ="Error: Return address details"
    }
    else{
        pageTitle ="Return address details"
    }
}else{
    if(error_report && error_report.length>0){
        pageTitle ="Error: Return address if we can’t legalise your documents"
    }
    else{
        pageTitle ="Return address if we can’t legalise your documents"
    }
}


var primaryAddressErrors = [];
if (error_report) {
    if (error_report[0][0].errMsgs) {
        error_report[0][0].errMsgs.forEach(
                function(error){
                    if (error.fieldName =="full_name") {
                        primaryAddressErrors.push(error);
                    }
                    if (error.fieldName =="postcode") {
                        primaryAddressErrors.push(error);
                    }
                    if (error.fieldName =="house_name") {
                        primaryAddressErrors.push(error);
                    }
                    if (error.fieldName =="street") {
                        primaryAddressErrors.push(error);
                    }
                    if (error.fieldName =="town") {
                        primaryAddressErrors.push(error);
                    }
                    if (error.fieldName =="county") {
                        primaryAddressErrors.push(error);
                    }
                    if (error.fieldName =="telephone") {
                      primaryAddressErrors.push(error);
                    }
                  if (error.fieldName =="mobileNo") {
                    primaryAddressErrors.push(error);
                  }
                    if (error.fieldName =="email") {
                     primaryAddressErrors.push(error);
                    }

                }
        )
    }

}

if(form_values.country != 'United Kingdom'){
    form_values= false}else{ form_values};
%>
<div class="inner_header <%if (!user_data.loggedIn){%>no-user-signed-in<%}%>" >
    <%
    var url = '/your-'+address_type+'-address-uk?is_uk=true' ;
    %>
 <a href="<%= url%>" class="govuk-back-link">Back</a>

    <%if (user_data.loggedIn) { %><%- partial ('../../partials/inner-header.ejs')%><%}%>

</div>

<div class="govuk-error-summary <% if (error_report) { %>show<% } else { %>hide<% } %>" aria-labelledby="error-summary-title" role="alert" tabindex="-1" data-module="govuk-error-summary">

    <h2 class="govuk-error-summary__title" id="error-summary-title">
        There is a problem
    </h2>

    <div class="govuk-error-summary__body" id="all-errors">
        <ul class="govuk-list govuk-error-summary__list">
            <% if (error_report) {  %>
                <% error_report[0][0].errMsgs.forEach(function(errorMsgs) { %>
                    <li>
                        <a href="<%= errorMsgs.questionId === 'town-county' ? '#' + 'town' : '#' + errorMsgs.questionId %>">
                            <%= errorMsgs.fieldSolution %>
                        </a>
                    </li>
                <% }) %>
            <% } %>
        </ul>
    </div>
</div>

<div class="govuk-grid-row">
<div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl"><%= address_type == 'main' ? 'Return address details' : 'Return address if we can’t legalise your documents' %></h1>

<form id="address_form" method="post" action="/add-uk-address">
    <div class="govuk-form-group" id="address-details-group">

        <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('full_name')>-1) { %>govuk-form-group--error<% } %>" id="legend_full_name">
            <label class="govuk-label" for="full-name">Full name</label>
            <span class="govuk-hint">Name of the person you would like the documents returned to</span>
            <input class="govuk-input govuk-!-width-one-half" id="full_name" type="text" name="full_name" aria-required="true" maxlength="255" value="<%if (form_values) { %><%= form_values.full_name %><% }else{%><%= user_address.address.full_name%><%} %>">

        </div>
        <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('organisation')>-1) { %>govuk-form-group--error<% } %>" id="legend_organisation">
            <label class="govuk-label" for="organisation">Company or organisation (optional)</label>
            <input class="govuk-input govuk-!-width-one-half" id="organisation" type="text" name="organisation" aria-required="true" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].organisation%><%} else if (form_values) { %><%= form_values.organisation %><% } %>" >
        </div>

        <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('house_name')>-1) { %>govuk-form-group--error<% } %>" id="legend_house_name">
            <label class="govuk-label" for="house_name">House name or number</label>
            <input class="govuk-input govuk-!-width-one-half" id="house_name" type="text" name="house_name" aria-required="true" maxlength="255" value="<%if(form_values && form_values.house_name && form_values.house_name != 'N/A') { %><%= form_values.house_name %><% } %>" >
        </div>

        <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('street')>-1) { %>govuk-form-group--error<% } %>" id="legend_street">
            <label class="govuk-label" for="street">Street</label>
            <input class="govuk-input govuk-!-width-one-half" type="text" id="street" name="street" aria-required="true" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].street%><%} else if (form_values) { %><%= form_values.street %><% } %>" >
        </div>

        <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('town-county')>-1) { %>govuk-form-group--error<% } %>" id="town-county">
            <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('town')>-1) { %>govuk-form-group--error<% } %>" id="legend_town">
                <label class="govuk-label" for="town">Town</label>
                <input class="govuk-input govuk-!-width-one-half" type="text" id="town" name="town" aria-required="true" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].town%><%} else if (form_values) { %><%= form_values.town %><% } %>" >
            </div>

            <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('county')>-1) { %>govuk-form-group--error<% } %>" id="legend_county">
                <label class="govuk-label" for="county">County <span>(optional)</span></label>
                <input class="govuk-input govuk-!-width-one-half" type="text" id="county" name="county" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].county%><%} else if (form_values) { %><%= form_values.county %><% } %>">
            </div>
        </div>

        <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('postcode')>-1) { %>govuk-form-group--error<% } %>" id="legend_postcode">
            <label class="govuk-label" for="postcode">Postcode</label>
            <input class="govuk-input govuk-!-width-one-quarter" id="postcode" aria-required="true" name="postcode" type="text" value="<%if(form_values[0]){%><%= form_values[0].postcode%><%} else if (form_values) { %><%= form_values.postcode %><% } %>" >
        </div>

        <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('mobileNo')>-1) { %>govuk-form-group--error<% } %>" id="legend_mobileNo">
            <label class="govuk-label" for="mobileNo">Mobile number</label>
            <span class="govuk-hint">Contact mobile number for this address for delivery questions or updates</span>
            <input class="govuk-input govuk-!-width-one-half" type="text" id="mobileNo" name="mobileNo"  maxlength="255" value="<%if (user_address.address.mobileNo == 'not found') { %><%%><% } else if(form_values[0]){%><%= form_values[0].mobileNo || ''%><%} else if (form_values) { %><%= form_values.mobileNo || '' %><% } else if (contact_mobileNo) { %><%= contact_mobileNo %><% } %>">

        </div>

      <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('telephone')>-1) { %>govuk-form-group--error<% } %>" id="legend_telephone">
        <label class="govuk-label" for="telephone">Secondary phone number <span>(optional)</span></label>
        <span class="govuk-hint">Contact telephone number for this address for delivery questions or updates</span>
        <input class="govuk-input govuk-!-width-one-half" type="text" id="telephone" name="telephone" aria-required="true" maxlength="255" value="<%if (user_address.address.telephone == 'not found') { %><%%><% } else if(form_values[0]){%><%= form_values[0].telephone%><%} else if (form_values) { %><%= form_values.telephone %><% } else if (contact_telephone) { %><%= contact_telephone %><% } %>">
      </div>

      <div class="govuk-form-group  <% if (error_report && error_report[1][0].erroneousFields.indexOf('email')>-1) { %>govuk-form-group--error<% } %>" id="legend_email">
        <label class="govuk-label" for="email">Email address <span>(optional)</span></label>
        <span class="govuk-hint">Contact email for this address for delivery questions or updates</span>
        <input class="govuk-input govuk-!-width-one-half" type="text" id="email" autocomplete="off" name="email" maxlength="255" value="<%if(form_values[0]){%><%= form_values[0].email || ''%><%} else if (form_values) { %><%= form_values.email || ''%><% } else if (contact_email) { %><%= contact_email %><% } %>">
      </div>

        <input type="hidden" name="country" value="United Kingdom">
        <input type="hidden" name="manual" value=true>
        <input type="hidden" name="address_type" value="<%= address_type%>">
    </div>

    <div class="govuk-form-group">
        <button id="NextBtn" class="govuk-button" data-module="govuk-button"><%if(summary){ %>Save and return to summary<% }else{%>Continue<%} %></button>
    </div>


</form>
</div>
</div>
