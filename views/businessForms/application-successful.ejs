<% pageTitle ="Application confirmation" %>
<!-- ARIA live region -->
<div id="sr-notification-container" class="govuk-visually-hidden" aria-live="assertive" aria-atomic="true"></div>


<div class="inner_header <%if (!user_data.loggedIn){%>no-user-signed-in<%}%>" >
    <% if (user_data.loggedIn) { %>
    <%- partial ('../partials/inner-header.ejs')%>
    <% } %>
</div>

<div class="govuk-grid-row">
    <div class="govuk-!-margin-bottom-6">
        <div class="govuk-panel govuk-panel--confirmation container-confirmed container">
            <h1 class="govuk-panel__title confirmed govuk-!-padding-top-5">
                <i class="flaticon-checked21" aria-hidden="true"></i>
                Application complete
            </h1>
            <div class="govuk-panel__body govuk-!-padding-bottom-5">
                Your reference number<br><strong><%= unique_application_id %></strong>
            </div>
        </div>

        <div class="govuk-inset-text govuk-!-margin-top-6 govuk-!-margin-bottom-0">
            <p class="govuk-body"><strong>Total paid:</strong> £<%= receipt.price.toFixed(2) %> for <%= receipt.doc_count %> document<%if(receipt.doc_count!=1){%>s<%}%>.</p>
            <%if(email!=null){%>
                <p class="govuk-body govuk-!-margin-bottom-0"><strong>Email confirmation sent to:</strong> <%= email %></p>
            <%}%>
        </div>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-form-group">
            <h2 class="govuk-heading-l nomargintop">What to do next</h2>
        </div>

        <h2 class="govuk-heading-m nomargintop">1. Print your cover sheet</h2>
        <%if(application_type===2 || application_type===3){%>
                    <p class="govuk-body">Please make sure you do not print double-sided</p>
        <%}%>

        <div class="govuk-form-group">
            <a class="govuk-button" href="/print-cover-sheet" target="_blank" id="print-cover" style="margin-bottom:0px">Print cover sheet <span class="govuk-visually-hidden"> opens in new window</span></a>
        </div>

        <p class="govuk-body">Please click the"Print cover sheet" button above to open the file. Once the file is open, right-click and select "Save As". This will enable you to save the file for printing at a later date.</p>

        <details class="govuk-details">
            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-text">
                  What to do if you don't have a printer?
                </span>
            </summary>
            <div class="govuk-details__text">
                <p class="govuk-body">If you don't have a printer, write down the application reference number, your name and address and send this to us with your documents.</p>
                <p class="govuk-body govuk-!-margin-bottom-0">We've also sent you an email with the application reference and office address details, so you have the option to print that at another computer later.</p>
            </div>
        </details>

        <div class="govuk-form-group">
            <h2 class="govuk-heading-m">2. Bring your documents</h2>
            <p class="govuk-body">Bring your documents along with a printout of your cover sheet to:</p>
            <%if(application_type==2){%>
                <p class="govuk-body">Building 84<br/>
                    Legalisation Office<br/>
                    Foreign, Commonwealth and Development Office<br/>
                    Hanslope Park<br/>
                    Hanslope<br/>
                    MK19 7BH<br/>
                </p>
            <%}else if(application_type==3){%>
                <p class="govuk-body">Legalisation Office<br/>Legalisation Office drop-off service<br/>
                    Building 84<br/>
                    Hanslope Park<br/>
                    Hanslope<br/>
                    Milton Keynes<br/>
                    MK19 7BH<br/>
                </p>
            <% } %>
        </div>

        <h2 class="govuk-heading-m">How long it takes and when you'll be charged</h2>
        <%if(application_type==2){%>
            <p class="govuk-body">
                The restricted urgent service is a same-day service for all pre-approved documents received before 12:20pm, excluding weekends and bank holidays.
                It is open for drop-off from 12pm to 12:20pm, and for collection from 1:30pm to 2pm. If there is a delay in processing your documents,
                we will contact you to let you know.
            </p>

        <p class="govuk-body">We manage payment as follows:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>your payment card is charged immediately</li>
            <li>if you haven’t submitted your documents within 60 days, your payment will be refunded and the money returned to your account - you'll need to make another application</li>
        </ul>
        <%}else if(application_type==3){%>
        <p class="govuk-body">It normally takes 24 hours to legalise your documents, excluding weekends, bank holidays and courier time.
            If there is a delay in processing your documents, we'll call you to let you know.</p>

        <p class="govuk-body">We manage payment as follows:</p>
        <ul class="govuk-list govuk-list--bullet">
            <li>your payment card is charged immediately</li>
            <li>if you haven’t submitted your documents within 60 days, your payment will be refunded and the money returned to your account - you'll need to make another application</li>
        </ul>
        <%}%>

        <div class="govuk-form-group">
            <p class="govuk-body">
                <a class="govuk-link" id="submit-application-feedback" href="<%= doneSurveyPremium%>" target="_blank">What did you think of this service?<span class="govuk-visually-hidden"> opens in new window</span></a> (takes 30 seconds)
            </p>
            <p class="govuk-body"><a class="govuk-link" href="/start">Start a new application</a></p>
            <% if (user_data.loggedIn) { %>
            <p class="govuk-body"><a class="govuk-link" id="submit-application-start-new" href="/dashboard">View my applications</a></p>
            <%}%>
        </div>
    </div>
</div>
